{
  "name": "mock-host-sandbox-regression",
  "build": {
    "dockerfile": "./Dockerfile"
  },

  "remoteUser": "vscode",

  // Mock secrets. `ANTHROPIC_API_KEY` is enumerated in sandbox.credentials.envVars
  // and `GITHUB_TOKEN` deliberately is not, so the verification can show that only
  // the enumerated one is scrubbed. Neither is a real credential.
  "remoteEnv": {
    "ANTHROPIC_API_KEY": "sk-ant-MOCK-NOT-A-REAL-KEY",
    "GITHUB_TOKEN": "ghp_MOCKNOTAREALTOKEN"
  },

  "runArgs": [
    "--name=mock-host-sandbox-regression",
    // bubblewrap must create user/mount namespaces inside the container and
    //   seccomp+apparmor              -> "Creating new namespace failed"
    //   seccomp+apparmor+SYS_ADMIN    -> "Can't mount proc on /newroot/proc"
    //   seccomp+apparmor+systempaths  -> works
    // systempaths=unconfined matters: it lifts Docker's /proc masking,
    // which is what blocks the procfs mount. SYS_ADMIN is not needed.
    "--security-opt=seccomp=unconfined",
    "--security-opt=apparmor=unconfined",
    "--security-opt=systempaths=unconfined"
  ],

  // mount under /home/vscode to mock host environment
  "workspaceMount": "source=${localWorkspaceFolder},target=/home/vscode/workspace,type=bind",
  "workspaceFolder": "/home/vscode/workspace",

  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {},
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    },
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
  },

  "postCreateCommand": ".devcontainer/post_create.sh"
}
