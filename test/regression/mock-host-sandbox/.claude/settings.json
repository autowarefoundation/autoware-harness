{
  "permissions": {
    "defaultMode": "default",
    "blockReadsOutsideWorkingDirectories": false,
    "allow": [
      "Read(/usr/**)",
      "Read(/etc/**)",
      "Read(~/.gitconfig)",
      "Read(~/.config/gh/**)",
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(node:*)",
      "Bash(npm:*)",
      "Bash(cargo:*)",
      "Bash(rustc:*)"
    ],
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.claude/**)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "filesystemPolicy": "strict",
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [],
    "filesystem": {
      "denyRead": ["~/"],
      "allowRead": ["~/.gitconfig", "~/.config/gh", "~/.rustup"],
      "allowWrite": [".", "~/.cargo"]
    },
    "credentials": {
      "envVars": [{ "name": "ANTHROPIC_API_KEY", "mode": "deny" }]
    }
  }
}
